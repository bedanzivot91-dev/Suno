{
  "manifest_version": 3,
  "name": "Suno Original Finder 2.1 — Suno Pesme Studio",
  "short_name": "Suno Original 2.1",
  "version": "2.1.0",
  "description": "Automatski prepoznaje originalnu Suno pesmu u YouTube videu ili Shorts-u preko lokalnog Bridge-a i indeksirane biblioteke Suno Pesme Studio.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "contextMenus",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "shared/core.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Suno Original Finder",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_page": "options/options.html",
  "commands": {
    "recognize-current-video": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Prepoznaj Suno original trenutnog YouTube videa"
    },
    "toggle-card": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Prikaži ili sakrij karticu Suno originala"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "key": ""
}
